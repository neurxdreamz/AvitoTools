<Window x:Class="ImageUniqueizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageUniqueizer" Height="640" Width="740"
        Background="#0D0D11" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ==================== COLORS ==================== -->
        <SolidColorBrush x:Key="BgDeep" Color="#0D0D11"/>
        <SolidColorBrush x:Key="BgCard" Color="#1A1A22"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#22222C"/>
        <SolidColorBrush x:Key="BgInput" Color="#141419"/>
        <SolidColorBrush x:Key="BorderDark" Color="#2D1F24"/>
        <SolidColorBrush x:Key="BorderMid" Color="#33333E"/>
        <SolidColorBrush x:Key="BorderNeon" Color="#FF2A4D"/>
        <SolidColorBrush x:Key="NeonRed" Color="#FF2A4D"/>
        <SolidColorBrush x:Key="NeonRedDim" Color="#CC2240"/>
        <SolidColorBrush x:Key="NeonRedBright" Color="#FF4D6D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8A8A99"/>
        <SolidColorBrush x:Key="TextMuted" Color="#555566"/>

        <!-- ==================== GLOW EFFECTS ==================== -->
        <DropShadowEffect x:Key="NeonGlowStrong"
                          Color="#FF2A4D" BlurRadius="22" ShadowDepth="0" Opacity="0.65"/>
        <DropShadowEffect x:Key="NeonGlowMedium"
                          Color="#FF2A4D" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
        <DropShadowEffect x:Key="NeonGlowSubtle"
                          Color="#FF2A4D" BlurRadius="10" ShadowDepth="0" Opacity="0.30"/>

        <!-- ==================== SCROLLBAR ==================== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ==================== TEXTBOX ==================== -->
        <Style x:Key="CyberTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#141419"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#33333E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#FF2A4D"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#FF2A4D"/>
        </Style>

        <!-- ==================== DARK BUTTON ==================== -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A22"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#33333E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252530"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF2A4D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18181F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#141419"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#22222C"/>
                                <Setter Property="Foreground" Value="#444455"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== ACCENT (NEON RED) BUTTON ==================== -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2A4D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="36,14"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource NeonGlowStrong}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF2A4D" BlurRadius="20" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF4D6D"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                                             To="30" Duration="0:0:0.25"
                                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                             To="0.85" Duration="0:0:0.25"
                                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                                             To="20" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                             To="0.55" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CC2240"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A1A22"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="#444455"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== CARD BORDER ==================== -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1A1A22"/>
            <Setter Property="BorderBrush" Value="#2D1F24"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

    </Window.Resources>

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Background="#FF2A4D" CornerRadius="6" Padding="10,5" Margin="0,0,12,0"
                    VerticalAlignment="Center">
                <TextBlock Text="&#x2699;" FontSize="14" Foreground="#FFFFFF"
                           VerticalAlignment="Center" Margin="0,-1,0,0"/>
            </Border>
            <TextBlock Text="ImageUniqueizer"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#FFFFFF"
                       VerticalAlignment="Center"/>
            <TextBlock Text="  v1.0"
                       FontSize="12" FontWeight="Normal"
                       Foreground="#555566"
                       VerticalAlignment="Bottom" Margin="0,0,0,4"/>
        </StackPanel>

        <!-- ==================== DROP ZONE ==================== -->
        <Border Grid.Row="1"
                x:Name="DropZone"
                AllowDrop="True"
                BorderBrush="#33333E"
                BorderThickness="1.5"
                CornerRadius="12"
                Background="#141419"
                Height="160"
                Margin="0,0,0,14"
                Cursor="Hand">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#FF2A4D"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF2A4D" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- Dashed inner overlay -->
            <Border BorderThickness="1.5" CornerRadius="10" Margin="6"
                    IsHitTestVisible="False">
                <Border.BorderBrush>
                    <VisualBrush Stretch="None">
                        <VisualBrush.Visual>
                            <Rectangle Width="800" Height="200" Stroke="#FF2A4D" StrokeThickness="1.5"
                                       StrokeDashArray="4 3" Opacity="0.35"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.BorderBrush>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Upload icon (text-based) -->
                    <Border Width="52" Height="52" CornerRadius="26"
                            Background="#1A1A22" BorderBrush="#33333E" BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="&#x2B06;" FontSize="22" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="#FF2A4D" Margin="0,-2,0,0"/>
                    </Border>
                    <TextBlock x:Name="DropZoneText"
                               Text="Перетащите сюда фотографии товаров (JPG, PNG, WEBP)&#x0a;или нажмите для выбора"
                               TextAlignment="Center"
                               Foreground="#8A8A99"
                               FontSize="13"
                               LineHeight="21"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ==================== FILE INFO ROW ==================== -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4C1;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FileCountText"
                               Text="Выбрано файлов: 0"
                               Foreground="#8A8A99"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="ClearFilesButton"
                        Content="&#x2715;  Очистить"
                        Style="{StaticResource DarkButton}"
                        Padding="12,5"
                        FontSize="12"
                        Click="ClearFilesButton_Click"
                        Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ==================== SETTINGS ROW ==================== -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sets count card -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Количество наборов"
                               Foreground="#8A8A99" FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="SetsCountBox"
                             Text="3"
                             Style="{StaticResource CyberTextBox}"
                             MaxLength="3"
                             Width="80"
                             HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Output path card -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Папка сохранения"
                                   Foreground="#8A8A99" FontSize="11" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1"
                                   x:Name="OutputPathText"
                                   Text="(не выбрана)"
                                   Foreground="#555566"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,2"/>
                    </Grid>
                </Border>

                <!-- Browse button -->
                <Button Grid.Column="1"
                        x:Name="BrowseButton"
                        Content="&#x2026;"
                        Style="{StaticResource DarkButton}"
                        Padding="12,10"
                        FontSize="16"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top"
                        ToolTip="Выбрать папку"
                        Click="BrowseButton_Click"/>
            </Grid>
        </Grid>

        <!-- ==================== PROGRESS BAR ==================== -->
        <Border Grid.Row="4" CornerRadius="4" Margin="0,0,0,8"
                Background="#141419" Height="8"
                Visibility="Collapsed" x:Name="ProgressBorder">
            <ProgressBar x:Name="ProgressBar"
                         Minimum="0" Maximum="100"
                         Background="Transparent"
                         BorderThickness="0"
                         Height="8">
                <ProgressBar.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#CC2240" Offset="0"/>
                        <GradientStop Color="#FF2A4D" Offset="0.5"/>
                        <GradientStop Color="#FF4D6D" Offset="1"/>
                    </LinearGradientBrush>
                </ProgressBar.Foreground>
                <ProgressBar.Effect>
                    <DropShadowEffect Color="#FF2A4D" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                </ProgressBar.Effect>
            </ProgressBar>
        </Border>

        <!-- ==================== STATUS TEXT ==================== -->
        <TextBlock Grid.Row="5"
                   x:Name="StatusText"
                   Text=""
                   Foreground="#8A8A99"
                   FontSize="13"
                   Margin="0,2,0,14"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <!-- ==================== BUTTONS ROW ==================== -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,8,0,0">

            <Button x:Name="ProcessButton"
                    Content="Уникализировать фото"
                    Style="{StaticResource AccentButton}"
                    IsEnabled="False"
                    Click="ProcessButton_Click"/>

            <Button x:Name="OpenResultButton"
                    Content="Открыть папку с результатом"
                    Style="{StaticResource DarkButton}"
                    Padding="24,12"
                    FontSize="13"
                    Margin="14,0,0,0"
                    IsEnabled="False"
                    Visibility="Collapsed"
                    Click="OpenResultButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
